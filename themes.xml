<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ink">#FF06070C</color>

    <style name="Theme.Nova" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:colorAccent">#FFFF4F7B</item>
    </style>

    <style name="Theme.Nova.Player" parent="Theme.Nova">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
